{
  "name": "zombielauncher",
  "version": "1.0.11",
  "description": "ZombieLauncher Minecraft NeoForge Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon --exec electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.zombielauncher.launcher",
    "productName": "ZombieLauncher",
    "artifactName": "ZombieLauncher-${version}.${ext}",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "launcher/**/*",
      "auth/**/*",
      "admin/**/*",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "config/**/*"
    ],
    "win": {
      "icon": "src/renderer/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/renderer/assets/icon.ico",
      "uninstallerIcon": "src/renderer/assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true,
      "shortcutName": "ZombieLauncher"
    }
  },
  "dependencies": {
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "electron-store": "^10.0.0",
    "extract-zip": "^2.0.1",
    "express": "^5.2.1",
    "fs-extra": "^11.3.6",
    "minecraft-launcher-core": "^3.18.2",
    "multer": "^2.2.0",
    "node-fetch": "^2.7.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "nodemon": "^3.1.0"
  }
}
